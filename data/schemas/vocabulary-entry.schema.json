{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/izzy9118-blip/greek/data/schemas/vocabulary-entry.schema.json",
  "title":"Greek Vocabulary Entry",
  "type":"object",
  "additionalProperties":false,
  "required":["id","type","schema_version","status","title","source","origin","created_at","updated_at","lemma","normalized_lemma","principal_forms","part_of_speech","glosses","first_unit","notes","source_locations","skill_ids"],
  "properties":{
    "id":{"type":"string","pattern":"^VOC-[0-9]{6}$"},
    "type":{"const":"vocabulary_entry"},
    "schema_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status":{"enum":["draft","reviewed","validated","deprecated"]},
    "title":{"type":"string","minLength":1},
    "source":{"$ref":"#/$defs/source"},
    "origin":{"enum":["source-derived","editorial","generated"]},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "lemma":{"type":"string","minLength":1},
    "normalized_lemma":{"type":"string","minLength":1},
    "principal_forms":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "part_of_speech":{"enum":["noun","verb","adjective","adverb","pronoun","article","preposition","conjunction","particle","interjection","numeral"]},
    "gender":{"enum":["masculine","feminine","neuter","common",null]},
    "declension":{"enum":["first","second","third",null]},
    "conjugation":{"type":["string","null"]},
    "principal_parts":{"type":"array","maxItems":6,"items":{"type":["string","null"]}},
    "governed_cases":{"type":"array","uniqueItems":true,"items":{"enum":["nominative","genitive","dative","accusative","vocative"]}},
    "glosses":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "first_unit":{"type":"string","pattern":"^UNT-[0-9]{3}$"},
    "accent_class":{"enum":["persistent","recessive","irregular",null]},
    "notes":{"type":"array","items":{"type":"string"}},
    "source_locations":{"type":"array","items":{"$ref":"#/$defs/source"}},
    "skill_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^SKL-[0-9]{6}$"}}
  },
  "$defs":{"source":{"type":"object","additionalProperties":false,"required":["work","unit","section","page"],"properties":{"work":{"const":"Hansen and Quinn, Greek: An Intensive Course"},"unit":{"type":["integer","null"],"minimum":0,"maximum":20},"section":{"type":["integer","null"],"minimum":1},"page":{"oneOf":[{"type":"integer","minimum":1},{"type":"string","pattern":"^[0-9]+(?:-[0-9]+)?$"},{"type":"null"}]},"note":{"type":"string"}}}}
}