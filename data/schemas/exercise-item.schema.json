{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/izzy9118-blip/greek/data/schemas/exercise-item.schema.json",
  "title":"Greek Exercise Item",
  "type":"object",
  "additionalProperties":false,
  "required":["id","type","schema_version","status","title","source","origin","created_at","updated_at","unit_id","section_ids","exercise_kind","prompt","response_schema","accepted_answers","skill_ids","feedback_rules","source_reference"],
  "properties":{
    "id":{"type":"string","pattern":"^EXR-[0-9]{6}$"},
    "type":{"const":"exercise_item"},
    "schema_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status":{"enum":["draft","reviewed","validated","deprecated"]},
    "title":{"type":"string","minLength":1},
    "source":{"$ref":"#/$defs/source"},
    "origin":{"enum":["source-derived","editorial","generated"]},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "unit_id":{"type":"string","pattern":"^UNT-[0-9]{3}$"},
    "section_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^SEC-[0-9]{4}$"}},
    "exercise_kind":{"enum":["recognize","recall","parse","generate","transform","match","explain","translate","compose","read-aloud"]},
    "prompt":{"type":"object","additionalProperties":false,"required":["display"],"properties":{"display":{"type":"string","minLength":1},"instructions":{"type":"string"},"context":{"type":"string"}}},
    "response_schema":{"type":"object","additionalProperties":true},
    "accepted_answers":{"type":"array","minItems":1,"items":{}},
    "skill_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^SKL-[0-9]{6}$"}},
    "feedback_rules":{"type":"array","items":{"type":"object"}},
    "source_reference":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"enum":["source-derived","adapted","original","generated"]},"note":{"type":"string"}}}
  },
  "$defs":{"source":{"type":"object","additionalProperties":false,"required":["work","unit","section","page"],"properties":{"work":{"const":"Hansen and Quinn, Greek: An Intensive Course"},"unit":{"type":["integer","null"],"minimum":0,"maximum":20},"section":{"type":["integer","null"],"minimum":1},"page":{"oneOf":[{"type":"integer","minimum":1},{"type":"string","pattern":"^[0-9]+(?:-[0-9]+)?$"},{"type":"null"}]},"note":{"type":"string"}}}}
}