{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/izzy9118-blip/greek/data/schemas/unit.schema.json",
  "title": "Greek Curriculum Unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "schema_version", "status", "title", "source", "origin", "created_at", "updated_at", "number", "prerequisites", "section_ids", "vocabulary_ids", "exercise_ids", "reading_ids", "skill_ids"],
  "properties": {
    "id": {"type": "string", "pattern": "^UNT-[0-9]{3}$"},
    "type": {"const": "unit"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "reviewed", "validated", "deprecated"]},
    "title": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "origin": {"enum": ["source-derived", "editorial", "generated"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "number": {"type": "integer", "minimum": 0, "maximum": 20},
    "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^UNT-[0-9]{3}$"}},
    "section_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SEC-[0-9]{4}$"}},
    "vocabulary_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^VOC-[0-9]{6}$"}},
    "exercise_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EXR-[0-9]{6}$"}},
    "reading_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REA-[0-9]{6}$"}},
    "skill_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SKL-[0-9]{6}$"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work", "unit", "section", "page"],
      "properties": {
        "work": {"const": "Hansen and Quinn, Greek: An Intensive Course"},
        "unit": {"type": ["integer", "null"], "minimum": 0, "maximum": 20},
        "section": {"type": ["integer", "null"], "minimum": 1},
        "page": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^[0-9]+(?:-[0-9]+)?$"}, {"type": "null"}]},
        "note": {"type": "string"}
      }
    }
  }
}