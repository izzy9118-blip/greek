{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/greek/schemas/learning-objective.schema.json",
  "title": "Learning Objective",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "schema_version", "status", "description", "skill_ids", "mastery_threshold", "origin"],
  "properties": {
    "id": {"type": "string", "pattern": "^OBJ-[0-9]{6}$"},
    "type": {"const": "learning_objective"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "reviewed", "validated", "deprecated"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "unit_ids": {"type": "array", "items": {"type": "string", "pattern": "^UNT-[0-9]{3}$"}, "uniqueItems": true, "default": []},
    "section_ids": {"type": "array", "items": {"type": "string", "pattern": "^SEC-[0-9]{4}$"}, "uniqueItems": true, "default": []},
    "skill_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SKL-[0-9]{6}$"}, "uniqueItems": true},
    "mastery_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "prerequisite_objective_ids": {"type": "array", "items": {"type": "string", "pattern": "^OBJ-[0-9]{6}$"}, "uniqueItems": true, "default": []},
    "origin": {"enum": ["source-derived", "editorial", "generated"]},
    "source": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "work": {"type": "string"},
        "unit": {"type": ["integer", "null"], "minimum": 0},
        "section": {"type": ["string", "null"]},
        "page": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]}
      }
    }
  }
}
