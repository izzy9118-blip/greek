{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/izzy9118-blip/greek/data/schemas/grammar-rule.schema.json",
  "title":"Greek Grammar Rule",
  "type":"object",
  "additionalProperties":false,
  "required":["id","type","schema_version","status","title","source","origin","created_at","updated_at","statement","scope","prerequisites","examples","exceptions","skill_ids"],
  "properties":{
    "id":{"type":"string","pattern":"^GRM-[0-9]{6}$"},
    "type":{"const":"grammar_rule"},
    "schema_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status":{"enum":["draft","reviewed","validated","deprecated"]},
    "title":{"type":"string","minLength":1},
    "source":{"$ref":"#/$defs/source"},
    "origin":{"enum":["source-derived","editorial","generated"]},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "statement":{"type":"string","minLength":1},
    "scope":{"type":"object","additionalProperties":false,"required":["units","sections"],"properties":{"units":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^UNT-[0-9]{3}$"}},"sections":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^SEC-[0-9]{4}$"}}}},
    "prerequisites":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^GRM-[0-9]{6}$"}},
    "examples":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["greek"],"properties":{"greek":{"type":"string","minLength":1},"translation":{"type":"string"},"note":{"type":"string"}}}},
    "exceptions":{"type":"array","items":{"type":"string"}},
    "skill_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^SKL-[0-9]{6}$"}}
  },
  "$defs":{"source":{"type":"object","additionalProperties":false,"required":["work","unit","section","page"],"properties":{"work":{"const":"Hansen and Quinn, Greek: An Intensive Course"},"unit":{"type":["integer","null"],"minimum":0,"maximum":20},"section":{"type":["integer","null"],"minimum":1},"page":{"oneOf":[{"type":"integer","minimum":1},{"type":"string","pattern":"^[0-9]+(?:-[0-9]+)?$"},{"type":"null"}]},"note":{"type":"string"}}}}
}